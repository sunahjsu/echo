# ===========================================
# PCA图像检索系统环境配置示例
# ===========================================

# 数据路径配置
DATASET_PATH=/path/to/your/dataset
# 可选数据路径：
# DATASET_PATH=/path/to/your/dataset

# MLflow配置
MLFLOW_TRACKING_URI=http://localhost:5001
# 可选MLflow跟踪URI：
# MLFLOW_TRACKING_URI=./mlruns                    # 本地文件存储
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000      # 本地MLflow服务器
# MLFLOW_TRACKING_URI=https://dagshub.com/your_username/your_repo.mlflow  # DagsHub

MLFLOW_EXPERIMENT_NAME=PCA_Image_Retrieval
# 可选实验名称：
# MLFLOW_EXPERIMENT_NAME=image_retrieval_dev
# MLFLOW_EXPERIMENT_NAME=pca_retrieval_prod

# PCA配置
PCA_COMPONENTS=50
# 可选PCA组件数：
# PCA_COMPONENTS=30
# PCA_COMPONENTS=100

# 图像处理配置
IMAGE_SIZE=128
GRAYSCALE=true
NORMALIZE=true

# 检索配置
TOP_K=10
DISTANCE_METRIC=euclidean
# 可选距离度量：
# DISTANCE_METRIC=cosine
# DISTANCE_METRIC=manhattan

# DagsHub配置（可选）
DAGSHUB_USERNAME=your_username
DAGSHUB_TOKEN=your_token
DAGSHUB_REPO_OWNER=your_username
DAGSHUB_REPO_NAME=your_repo_name

# Flask应用配置（如果使用Web界面）
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 环境标识
ENVIRONMENT=development
# 可选环境：
# ENVIRONMENT=staging
# ENVIRONMENT=production

# 日志配置
LOG_LEVEL=INFO
# 可选日志级别：
# LOG_LEVEL=DEBUG
# LOG_LEVEL=WARNING

# 测试配置
TEST_DATA_RATIO=0.2
RANDOM_STATE=42